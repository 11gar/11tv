# Copier en .env (non versionné) pour surcharger les valeurs par défaut.
# Sur la Surface, les valeurs par défaut conviennent : ce fichier sert surtout au développement.

# Dossier des données (réglages, sessions, certificats, fonds d'écran, profil Edge).
# Par défaut : %LOCALAPPDATA%\11TV
ELEVENTV_DATA_DIR=.data

# Ports : HTTPS pour le téléphone, HTTP local (127.0.0.1) pour l'écran TV, HTTP d'installation du certificat
ELEVENTV_HTTPS_PORT=8443
ELEVENTV_TV_PORT=8080
ELEVENTV_SETUP_PORT=8081

# Edge : lancement automatique, plein écran (false = fenêtre d'application, pratique en développement)
ELEVENTV_EDGE_LAUNCH=true
ELEVENTV_EDGE_KIOSK=false
ELEVENTV_EDGE_DEBUG_PORT=9222
# ELEVENTV_EDGE_PATH=C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe

# Nom mDNS inclus dans le certificat (par défaut : <nom de la machine>.local)
# ELEVENTV_HOSTNAME=11tv.local

ELEVENTV_LOG_LEVEL=debug
